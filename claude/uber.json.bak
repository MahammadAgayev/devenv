{
  "apiKeyHelper": "/Users/aghayev/.local/share/aifx/bin/claude-genai-token-helper",
  "autoCompactEnabled": false,
  "availableModels": [
    "sonnet",
    "opus",
    "haiku",
    "fable"
  ],
  "disableWorkflows": true,
  "effortLevel": "medium",
  "enabledMcpjsonServers": [
    "code-mcp"
  ],
  "enabledPlugins": {
    "agent-guard@agent-marketplace": true,
    "code-mode@agent-marketplace": true,
    "cost-check@agent-marketplace": true,
    "data-analyst@agent-marketplace": true,
    "google-workspace@agent-marketplace": true,
    "gopls-lsp@claude-plugins-official": true,
    "jr@reichert-skills": true,
    "lua-lsp@claude-plugins-official": true,
    "slack@agent-marketplace": true,
    "uber-dev@agent-marketplace": true,
    "uber-reviewer@agent-marketplace": true
  },
  "env": {
    "ANTHROPIC_BASE_URL": "https://genai-api.uberinternal.com",
    "ANTHROPIC_CUSTOM_HEADERS": "OpenAI-Organization: 3caa75e6-e440-4b5e-afc5-4cc3231cceb4",
    "ANTHROPIC_CUSTOM_MODEL_OPTION": "claude-opus-5[1m]",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION": "Claude Opus 5",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME": "Opus 5",
    "ANTHROPIC_VERTEX_BASE_URL": "https://genai-api.uberinternal.com/v1",
    "ANTHROPIC_VERTEX_PROJECT_ID": "progsys-genai-198685",
    "CLAUDE_CODE_API_KEY_HELPER_TTL_MS": "3600000",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "400000",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
    "CLAUDE_CODE_ENABLE_AUTO_MODE": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_OTEL_HEADERS_HELPER_DEBOUNCE_MS": "3600000",
    "CLAUDE_CODE_SKIP_VERTEX_AUTH": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1",
    "CLAUDE_CODE_USE_VERTEX": "0",
    "CLOUD_ML_REGION": "global",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_INSTALLATION_CHECKS": "1",
    "ENABLE_IDE_INTEGRATION": "true",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "ENABLE_TOOL_SEARCH": "false",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://aifx-telemetry-proxy.uberinternal.com",
    "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "delta",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_SERVICE_NAME": "claude-code",
    "OTEL_SERVICE_VERSION": "1.0.0"
  },
  "extraKnownMarketplaces": {
    "reichert-skills": {
      "source": {
        "source": "git",
        "url": "gitolite@code.uber.internal:not-production/personal-reichert-dotfiles"
      }
    },
    "uber-code/devexp-agent-marketplace": {
      "source": {
        "path": "/Users/aghayev/.local/share/aifx/marketplaces/uber-code/devexp-agent-marketplace",
        "source": "directory"
      }
    }
  },
  "fastMode": false,
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "async": true,
            "command": "aifx analytics emit --agent claude_code",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "aifx analytics emit --agent claude_code",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "async": true,
            "command": "aifx analytics emit --agent claude_code",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/rtk-rewrite.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "aifx analytics emit --agent claude_code",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "async": true,
            "command": "aifx analytics emit --agent claude_code",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "async": true,
            "command": "aifx analytics emit --agent claude_code",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "aifx analytics emit --agent claude_code",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "async": true,
            "command": "aifx analytics emit --agent claude_code",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "aifx analytics emit --agent claude_code",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "async": true,
            "command": "aifx analytics emit --agent claude_code",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "claude-opus-5[1m]",
  "modelSettings": {
    "claude-opus-4-6": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "otelHeadersHelper": "/Users/aghayev/.local/share/aifx/bin/claude-telemetry-token-helper",
  "permissions": {
    "allow": [
      "Bash(basename *)",
      "Bash(bazel build *)",
      "Bash(bazel test *)",
      "Bash(cat *)",
      "Bash(cut *)",
      "Bash(date *)",
      "Bash(diff *)",
      "Bash(dirname *)",
      "Bash(du *)",
      "Bash(echo *)",
      "Bash(env)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(git -C * diff *)",
      "Bash(git -C * log *)",
      "Bash(git -C * status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(printenv *)",
      "Bash(pwd)",
      "Bash(realpath *)",
      "Bash(sort *)",
      "Bash(stat *)",
      "Bash(tail *)",
      "Bash(test *)",
      "Bash(tree *)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(rtk *)",
      "WebFetch",
      "mcp__monorepo-experts-mcp-server__generate_standard_go_mocks",
      "mcp__monorepo-experts-mcp-server__generate_glue_go_mocks",
      "mcp__monorepo-experts-mcp-server__update_build_files",
      "mcp__monorepo-experts-mcp-server__get_coverage_report"
