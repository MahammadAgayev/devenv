# Font. Must be a Nerd Font: the p10k prompt uses glyphs from the Private Use
# Area (U+E0A0 branch, U+E0B0 separators) that unpatched fonts render blank —
# the symptom is a gap where the git branch icon should be, not an error.
font-family = "MesloLGS NF"

# Window Background Opacity (0.0 = fully transparent, 1.0 = fully opaque)
background-opacity = 0.85

# Background Blur (creates a modern frosted-glass/aero effect)
background-blur = 10

# Optional: Opacity for unfocused split panes
unfocused-split-opacity = 0.60
macos-non-native-fullscreen = true
